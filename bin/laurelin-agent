#!/usr/bin/env bash
# laurelin-agent: start Laurelin Agent (a Prime Agent fork) with the Laurelin pack, and manage API keys.
#
# Plan: PLAN.md section 10, Steps 1b and 1e. Brief: docs/briefs/launcher.md.
# Keys live in ~/.config/agent-keys/env (one NAME=value per line, mode 600).
# This script reads that file into the environment and never prints a value.

set -euo pipefail

# Find the repo root, even when this script is reached through a symlink.
self="$0"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in
    /*) self="$target" ;;
    *) self="$(dirname "$self")/$target" ;;
  esac
done
REPO="$(cd "$(dirname "$self")/.." && pwd)"
PACK="$REPO/pack"
STORE="${LAURELIN_KEY_STORE:-$HOME/.config/agent-keys/env}"

# Expected key names, whether each is required, and which tool uses it.
# Names only. No value ever appears in this file.
KEY_TABLE="
TYPESAFE_API_KEY required Jev judgments (jev, jev-decide, jev-sweep, fastbrowse)
CONTEXT_DEV_API_KEY required context.dev research tool (MCP server)
FOLK_API_KEY required Folk CRM (investor and contact records)
OPENAI_API_KEY required gbrain embeddings
GITLAB_TOKEN required GitLab (git remotes)
VENICE_API_KEY optional Venice models
EXA_API_KEY optional Exa search skills (exa-search, company-research, deep-research)
FIRECRAWL_API_KEY optional Firecrawl skills (research index, deep research, SEO audit, competitive intel)
POLYGRES_API_KEY optional Polygres project key (memory sync through the SDK)
POLYGRES_RUNTIME_URL optional Polygres Runtime API URL (from the project's Connect page)
"

die() { echo "laurelin: $*" >&2; exit 1; }

usage() {
  cat <<EOF
laurelin-agent: Laurelin Agent, a Prime Agent fork, with the Laurelin pack.

Usage:
  laurelin                      Open an interactive session.
  laurelin-agent "task"               Open a session and start with this task.
  laurelin-agent -p "question"        Print one answer and exit. Good for scripts.
  laurelin-agent --autonomous "task"  Run until every gate in pack/gates passes,
                                or the agent's limits stop it.
  laurelin-agent --target <path> --claim "<text>" ...
                                Record the file the task produces and the claim
                                of done in .laurelin/task.json (in the current
                                folder) before the agent starts, so the gates read
                                them. Either flag alone is fine. The agent can
                                also set them with the set_task tool.
  laurelin-agent agents               See running and saved sessions, and reattach.
  laurelin list                 List agents.
  laurelin attach <agent>       Attach the screen to a running agent.
  laurelin send <agent> "msg"   Send a message to a running agent.
  laurelin stop <agent>         Stop an agent.
  laurelin-agent schedule ...         Prompts that run later or on a schedule.
  laurelin-agent worktrees           Worktrees of this repo: status, worker, changes, gates.
  laurelin-agent worktrees watch     Live dashboard of every worktree and its worker (q quits).
  laurelin-agent worktrees start <name> [--worker laurelin|claude|codex|none] <task>
                                Create a worktree with worktrunk and start a worker in it.
  laurelin-agent worktrees log|comment|status|stop|merge|remove <name> ...
  laurelin-agent wt ...               worktrunk itself (wt switch, wt list, wt merge).
  laurelin-agent keys add NAME        Store a key. You type the value; it is not shown.
  laurelin-agent keys list            Show key names and which tool uses each.
  laurelin-agent keys check           Show which expected keys are present or missing.
  laurelin-agent --help               This text.

Any other flag goes straight to Laurelin Agent (for example --model, --thinking,
--continue). Run "laurelin-agent help" for the full list.

Keys are read from $STORE at launch. Values are never printed.

To run "laurelin" from anywhere, make one symlink:
  ln -s "$REPO/bin/laurelin" ~/.local/bin/laurelin
EOF
}

# Read the key store into the environment. Prints nothing.
load_store() {
  if [ -f "$STORE" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$STORE" >/dev/null 2>&1 || true
    set +a
  fi
  # Amazon Bedrock signs in with an AWS profile. Use the company profile (IAM user laurelin-claude)
  # unless AWS credentials are already set. LAURELIN_AWS_PROFILE picks another one.
  if [ -z "${AWS_PROFILE:-}${AWS_ACCESS_KEY_ID:-}${AWS_BEARER_TOKEN_BEDROCK:-}" ]; then
    local prof="${LAURELIN_AWS_PROFILE:-laurelin}"
    grep -q "^\[profile $prof\]" "$HOME/.aws/config" 2>/dev/null && export AWS_PROFILE="$prof"
  fi
  return 0
}

# Names defined in the store, one per line. Values are not read.
store_names() {
  [ -f "$STORE" ] || return 0
  grep -E -o '^(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*=' "$STORE" \
    | sed -E 's/^export[[:space:]]+//; s/=$//'
}

# The tool that uses a key, from KEY_TABLE.
key_use() {
  printf '%s\n' "$KEY_TABLE" | awk -v n="$1" '$1 == n { $1 = ""; $2 = ""; sub(/^ +/, ""); print }'
}

keys_add() {
  local name="${1:-}" value quoted tmp replaced=0 line dir
  [[ "$name" =~ ^[A-Z][A-Z0-9_]*$ ]] || die "keys add: give a name in capitals, like FOLK_API_KEY"
  printf 'Value for %s (not shown): ' "$name" >&2
  IFS= read -r -s value
  printf '\n' >&2
  [ -n "$value" ] || die "keys add: no value given, nothing changed"

  dir="$(dirname "$STORE")"
  mkdir -p "$dir"
  chmod 700 "$dir"
  umask 077
  tmp="$(mktemp "$dir/.env.XXXXXX")"
  # Single quotes keep any character safe for "source". A quote inside the
  # value becomes '\'' which the shell reads back as one quote. sed gets the
  # value on stdin, never as an argument, so it never shows in a process list.
  quoted="'$(printf '%s' "$value" | sed "s/'/'\\\\''/g")'"

  if [ -f "$STORE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        "export $name="* | "$name="*)
          if [ "$replaced" -eq 0 ]; then
            printf 'export %s=%s\n' "$name" "$quoted"
            replaced=1
          fi
          ;;
        *) printf '%s\n' "$line" ;;
      esac
    done < "$STORE" > "$tmp"
  fi
  [ "$replaced" -eq 1 ] || printf 'export %s=%s\n' "$name" "$quoted" >> "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$STORE"
  chmod 600 "$STORE"
  if [ "$replaced" -eq 1 ]; then
    echo "$name: replaced in $STORE"
  else
    echo "$name: added to $STORE"
  fi
}

keys_list() {
  local n use
  [ -f "$STORE" ] || die "no key store at $STORE (use: laurelin keys add NAME)"
  echo "Keys in $STORE (names only):"
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    use="$(key_use "$n")"
    printf '  %-22s %s\n' "$n" "${use:-not in the table; no known tool uses it}"
  done < <(store_names)
}

# One line per expected name: present or missing. Exit 1 if a required key is missing.
keys_check() {
  local name need in_store missing=0
  load_store
  while read -r name need _; do
    [ -n "$name" ] || continue
    if store_names | grep -qx "$name"; then
      in_store=1
    else
      in_store=0
    fi
    if [ "$in_store" -eq 1 ]; then
      printf '%-22s present\n' "$name"
    elif [ -n "${!name:-}" ]; then
      printf '%-22s present (shell only, not in the store)\n' "$name"
    elif [ "$need" = optional ]; then
      printf '%-22s missing (optional)\n' "$name"
    else
      printf '%-22s missing\n' "$name"
      missing=1
    fi
  done <<< "$KEY_TABLE"
  return "$missing"
}

keys() {
  case "${1:-}" in
    add) shift; keys_add "$@" ;;
    list) keys_list ;;
    check) keys_check ;;
    *) die "keys: use add NAME, list, or check" ;;
  esac
}

# Write target and claim into .laurelin/task.json in the current folder (gitignored).
# Other keys in the file are kept. pack/gates/lib.sh reads this file.
write_task() {
  local target="$1" claim="$2" file="$PWD/.laurelin/task.json" existing='{}'
  mkdir -p "$PWD/.laurelin"
  if [ -s "$file" ]; then existing="$(jq -c . "$file" 2>/dev/null || echo '{}')"; fi
  case "$target" in ''|/*) ;; *) target="$PWD/$target" ;; esac
  printf '%s' "$existing" | jq --arg t "$target" --arg c "$claim" \
    '(if $t != "" then .target = $t else . end) | (if $c != "" then .claim = $c else . end)' > "$file.tmp" \
    && mv "$file.tmp" "$file"
}

# Start Prime with the pack, the theme if it exists, and the gates on autonomous runs.
# A rebuild gets a new service folder, but the old build's service keeps running and keeps holding
# its sessions, so `--continue` then fails with "Session is already active". When an old-build service
# is alive and every live service is idle (no window attached, nothing streaming or running tools),
# stop them all; the fork's shutdown stops every Laurelin service, never Prime Agent's. Otherwise
# leave everything alone: an open window or a background worker must not be cut off.
retire_old_services() {
  [ "${LAURELIN_USING_FORK:-}" = 1 ] || return 0
  local d old="" live=""
  for d in /tmp/laurelin-"$(id -u)"-*; do
    [ -S "$d/daemon.sock" ] || continue
    python3 -c 'import socket,sys; s=socket.socket(socket.AF_UNIX); s.settimeout(0.5); s.connect(sys.argv[1])' "$d/daemon.sock" 2>/dev/null || continue
    live="$live $d"
    [ "$d" != "$LAURELIN_SOCK_DIR" ] && old=1
  done
  [ -n "$old" ] || return 0
  for d in $live; do
    LAURELIN_DAEMON_SOCKET_DIR="$d" run_agent list --json 2>/dev/null | python3 -c '
import json, sys
try: sessions = json.load(sys.stdin).get("sessions", [])
except Exception: sys.exit(1)
keys = ("attachedClients", "isStreaming", "isRunningTools", "isBashRunning", "hasRunningRlmChildren", "isCompacting")
sys.exit(1 if any(any(s.get(k) for k in keys) for s in sessions) else 0)' || return 0
  done
  run_agent shutdown --force >/dev/null 2>&1 || true
}

launch() {
  local args a g fwd target="" claim=""
  load_store
  # Take --target and --claim out of the arguments; everything else goes to Prime.
  fwd=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --target) [ $# -ge 2 ] || die "--target needs a path"; target="$2"; shift 2 ;;
      --target=*) target="${1#--target=}"; shift ;;
      --claim) [ $# -ge 2 ] || die "--claim needs a text"; claim="$2"; shift 2 ;;
      --claim=*) claim="${1#--claim=}"; shift ;;
      *) fwd+=("$1"); shift ;;
    esac
  done
  set -- ${fwd[@]+"${fwd[@]}"}
  if [ -n "$target" ] || [ -n "$claim" ]; then write_task "$target" "$claim"; fi
  # Always load this repo's pack. Prime's settings may list another copy of the
  # pack by a relative path that resolves elsewhere; this repo's copy wins.
  args=(-e "$PACK")
  SETTINGS="${LAURELIN_CODING_AGENT_DIR:-$HOME/.prime/agent}/settings.json"
  if python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); sys.exit(0 if any("laurelin-harness/pack" in p for p in d.get("packages",[])) else 1)' "$SETTINGS" 2>/dev/null; then
    echo "note: $SETTINGS also lists a laurelin-harness pack; this repo's pack at $PACK is loaded as well." >&2
  fi
  # Coordinator model: the ChatGPT sign-in, never Prime's Claude sign-in (PLAN section 11).
  case " $* " in *" --model "*) ;; *) args+=(--model "${LAURELIN_MODEL:-openai-codex/gpt-6-astra}") ;; esac
  # The memory extension runs pack/memory/query.py; the Polygres SDK lives in the repo's own venv.
  if [ -x "$REPO/.laurelin/venv/bin/python" ]; then export LAURELIN_PYTHON="${LAURELIN_PYTHON:-$REPO/.laurelin/venv/bin/python}"; fi
  # gstack keys its state by repo; ~/package.json makes it resolve every repo to one slug.
  export GSTACK_PROJECT_SLUG="${GSTACK_PROJECT_SLUG:-laurelin-harness}"
  for t in "$PACK"/themes/*.json; do [ -f "$t" ] && args+=(--theme "$t"); done
  for a in "$@"; do
    if [ "$a" = "--autonomous" ]; then
      for g in "$PACK"/gates/*.sh; do
        # Only executable gates. lib.sh and other helpers are sourced, not run.
        case "$(basename "$g")" in lib*|_*) continue ;; esac
        # LAURELIN_GATES limits the set: a comma list of names ("prose,location"),
        # or "none" for no gates. Unset: every executable gate. Used by the test-set runner.
        if [ -n "${LAURELIN_GATES:-}" ]; then
          case ",${LAURELIN_GATES}," in *",$(basename "$g" .sh),"*) ;; *) continue ;; esac
        fi
        if [ -x "$g" ]; then
          args+=(--autonomous-gate "$g")
        fi
      done
      break
    fi
  done
  run_agent "${args[@]}" "$@"
}

# Prefer the forked agent built in this repo (agent/, a Prime Agent fork named laurelin).
# Fall back to a system prime-agent when the fork is not built.
FORK_CLI="$REPO/agent/packages/coding-agent/dist/bundle/cli.js"
# A working Node: prefer LAURELIN_NODE, then Homebrew's, then any node on PATH that actually starts.
NODE_BIN=""
for n in "${LAURELIN_NODE:-}" /opt/homebrew/bin/node "$(command -v node 2>/dev/null)"; do
  [ -n "$n" ] && [ -x "$n" ] && "$n" -e 0 >/dev/null 2>&1 && { NODE_BIN="$n"; break; }
done
if [ -f "$FORK_CLI" ]; then
  [ -n "$NODE_BIN" ] || die "No working Node found. Install Node 22 or newer (brew install node), or set LAURELIN_NODE."
  # The fork keeps its own settings folder, ~/.laurelin/agent, so the installed Prime
  # Agent's folder (~/.prime/agent) is never read or written by it. Only the sign-in
  # file is linked, so the ChatGPT and Claude subscriptions work without a new login.
  LAURELIN_AGENT_DIR="${LAURELIN_CODING_AGENT_DIR:-$HOME/.laurelin/agent}"
  if [ ! -d "$LAURELIN_AGENT_DIR" ]; then
    mkdir -p "$LAURELIN_AGENT_DIR"
    [ -f "$HOME/.prime/agent/auth.json" ] && ln -s "$HOME/.prime/agent/auth.json" "$LAURELIN_AGENT_DIR/auth.json"
    [ -f "$HOME/.prime/agent/models.json" ] && cp "$HOME/.prime/agent/models.json" "$LAURELIN_AGENT_DIR/models.json"
    printf '{\n  "theme": "laurelin"\n}\n' > "$LAURELIN_AGENT_DIR/settings.json"
    echo "laurelin: created $LAURELIN_AGENT_DIR (sign-in linked from ~/.prime/agent, settings fresh)" >&2
  fi
  export LAURELIN_CODING_AGENT_DIR="$LAURELIN_AGENT_DIR"
  # The background worker looks themes up by name in <agent dir>/themes; link the Laurelin themes there
  # so extensions color with the same theme as the screen.
  mkdir -p "$LAURELIN_AGENT_DIR/themes"
  for t in "$PACK"/themes/*.json; do [ -f "$t" ] && ln -sfn "$t" "$LAURELIN_AGENT_DIR/themes/$(basename "$t")"; done
  # Match the terminal: light background gets the light theme and the black mark,
  # dark background gets the dark theme and the white mark. LAURELIN_THEME overrides.
  # Asks the terminal itself (bin/detect-bg.py, OSC 11, BEL or ST reply). macOS's bash 3.2 cannot
  # read with a fractional timeout, so the old in-shell query always failed and fell back to dark.
  detect_bg() {
    local kind=""
    kind=$(python3 "$REPO/bin/detect-bg.py" 2>/dev/null)
    if [ -n "$kind" ]; then echo "$kind"; return; fi
    # No answer from the terminal: follow the macOS appearance.
    if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -qi dark; then echo dark; else echo light; fi
  }
  if [ -n "${LAURELIN_THEME:-}" ]; then
    THEME_NAME="$LAURELIN_THEME"; case "$THEME_NAME" in *bone*) LAURELIN_BG=light ;; *) LAURELIN_BG=dark ;; esac
  else
    LAURELIN_BG=$(detect_bg)
    if [ "$LAURELIN_BG" = light ]; then THEME_NAME=laurelin-bone; else THEME_NAME=laurelin; fi
  fi
  export LAURELIN_BG
  python3 - "$LAURELIN_AGENT_DIR/settings.json" "$THEME_NAME" <<'PY' 2>/dev/null || true
import json,sys
p,t=sys.argv[1],sys.argv[2]
try: d=json.load(open(p))
except Exception: d={}
if d.get("theme")!=t:
    d["theme"]=t; json.dump(d,open(p,"w"),indent=2); open(p,"a").write("\n")
PY
  # The fork keeps its own background service so it never collides with an installed Prime.
  # Socket keyed to the build, so a rebuilt fork never attaches to a service running old code.
  # Short path: macOS caps a socket path at 104 characters, and worker sockets add about 45 more.
  BUILD_KEY="$(stat -f %m "$FORK_CLI" 2>/dev/null || stat -c %Y "$FORK_CLI")"
  LAURELIN_SOCK_DIR="/tmp/laurelin-$(id -u)-${BUILD_KEY: -6}"
  mkdir -p "$LAURELIN_SOCK_DIR"
  # One service folder per build; every subcommand (agents, status, shutdown) uses it too, and none of them
  # can reach Prime Agent's own service in prime-agent-<uid>.
  export LAURELIN_DAEMON_SOCKET_DIR="$LAURELIN_SOCK_DIR"
  run_agent() { "$NODE_BIN" "$FORK_CLI" "$@"; }
  export LAURELIN_USING_FORK=1
  # Nothing about Laurelin's sessions goes to Prime's servers: no usage metrics, no version check.
  # (The fork's /update would install upstream Prime, not this fork.) Set LAURELIN_TELEMETRY=1 to allow metrics.
  [ "${LAURELIN_TELEMETRY:-0}" = 1 ] || export PRIME_AGENT_TELEMETRY=0
  export PI_SKIP_VERSION_CHECK=1
  # Jev for every harness caller (router, memory, context, gates): TypeSafe first, classifier.dev when
  # TypeSafe has no key or no credits. bin/path holds only the jev link, so no other command is shadowed.
  export JEV_BIN="$REPO/bin/jev"
  export PATH="$REPO/bin/path:$PATH"
else
  command -v prime-agent >/dev/null 2>&1 && run_agent() { prime-agent "$@"; } || die "Neither the built fork (agent/) nor prime-agent on PATH. Run: cd agent && npm install && npm run build"
fi

case "${1:-}" in
  -h | --help | help) usage ;;
  keys) shift; keys "$@" ;;
  providers) shift; load_store; exec python3 "$REPO/bin/providers.py" "$@" ;;
  graph) shift; if [ "${1:-}" = check ]; then exec "${NODE_BIN:-node}" "$PACK/graph/graph.mjs" "$@"; else load_store; exec "${NODE_BIN:-node}" "$PACK/graph/runner.mjs" "$@"; fi ;;
  worktrees) shift; exec "${NODE_BIN:-node}" "$PACK/worktrees/tracker.mjs" "$@" ;;
  wt) shift; exec "${LAURELIN_WT:-wt}" "$@" ;;
  agents | schedule | attach | send | list | stop | status | doctor | shutdown | mcp | package | update | model | session | config) load_store; run_agent "$@" ;;
  *) retire_old_services; launch "$@" ;;
esac
