#!/usr/bin/env python3
"""Read, list or write vault files with a fallback when macOS blocks ~/Documents.

Usage:
  vault-io read  <path>            print the file
  vault-io ls    <dir>             one name per line
  vault-io exists <path>           exit 0 if it exists
  vault-io write <path>            write stdin to the file (creates parent folders)

Direct access is tried first. On "Operation not permitted" (macOS privacy on
~/Documents for this process tree) the call goes through the AnorBridge file
proxy on 127.0.0.1:27300, which keeps its own grant. Token: ~/.anor_bridge_token.
Set LAURELIN_VAULT_BRIDGE=off to disable the fallback. Nothing leaves the machine.
"""
import json, os, sys, urllib.request

BRIDGE = "http://127.0.0.1:27300/exec"

def bridge(code: str) -> str:
    if os.environ.get("LAURELIN_VAULT_BRIDGE") == "off":
        raise PermissionError("bridge disabled")
    tok = open(os.path.expanduser("~/.anor_bridge_token")).read().strip()
    req = urllib.request.Request(BRIDGE, data=json.dumps({"token": tok, "code": code}).encode(),
                                 headers={"Content-Type": "application/json"})
    r = json.load(urllib.request.urlopen(req, timeout=60))
    if not r.get("ok"):
        raise RuntimeError(r.get("error") or "bridge error")
    return r.get("stdout") or ""

def main() -> int:
    if len(sys.argv) < 3:
        print(__doc__); return 2
    op, path = sys.argv[1], sys.argv[2]
    try:
        if op == "read":
            sys.stdout.write(open(path, encoding="utf8").read()); return 0
        if op == "ls":
            print("\n".join(sorted(os.listdir(path)))); return 0
        if op == "exists":
            return 0 if os.path.exists(path) else 1
        if op == "write":
            os.makedirs(os.path.dirname(path), exist_ok=True)
            open(path, "w", encoding="utf8").write(sys.stdin.read()); return 0
        print("unknown op", op); return 2
    except PermissionError:
        pass
    p = json.dumps(path)
    try:
        if op == "read":
            sys.stdout.write(bridge(f"import sys; sys.stdout.write(open({p}, encoding='utf8').read())")); return 0
        if op == "ls":
            sys.stdout.write(bridge(f"import os; print('\\n'.join(sorted(os.listdir({p}))))")); return 0
        if op == "exists":
            return 0 if bridge(f"import os; print(int(os.path.exists({p})))").strip() == "1" else 1
        if op == "write":
            data = json.dumps(sys.stdin.read())
            bridge(f"import os; os.makedirs(os.path.dirname({p}), exist_ok=True); open({p}, 'w', encoding='utf8').write({data})"); return 0
    except Exception as e:
        sys.stderr.write(f"vault-io: direct read denied and bridge failed: {e}\n"); return 3
    return 2

if __name__ == "__main__":
    sys.exit(main())
