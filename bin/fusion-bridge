#!/usr/bin/env python3
"""Talk to Autodesk Fusion through the AnorBridge add-in on 127.0.0.1:27300.

  fusion-bridge health                 is Fusion up, and which document is open
  fusion-bridge run <script.py>        run a Python file inside Fusion (adsk.core, adsk.fusion)
  fusion-bridge exec "<python>"        run a short Python snippet inside Fusion

The token is read from ~/.anor_bridge_token and sent in the JSON body. It is never printed.
Output: the script's stdout, then the returned value if any. Exit 1 on a bridge or script error.
"""
import json, os, sys, urllib.request

URL = os.environ.get("FUSION_BRIDGE_URL", "http://127.0.0.1:27300")

def call(path, body=None):
    req = urllib.request.Request(URL + path, data=None if body is None else json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json"})
    return json.load(urllib.request.urlopen(req, timeout=int(os.environ.get("FUSION_BRIDGE_TIMEOUT", "600"))))

def exec_code(code):
    tok = open(os.path.expanduser("~/.anor_bridge_token")).read().strip()
    r = call("/exec", {"token": tok, "code": code})
    if r.get("stdout"): sys.stdout.write(r["stdout"])
    if r.get("value") not in (None, ""): print(r["value"])
    if not r.get("ok"):
        sys.stderr.write(f"fusion-bridge: {r.get('error') or r}\n"); return 1
    return 0

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__); return 0
    op = sys.argv[1]
    try:
        if op == "health":
            print(json.dumps(call("/health"))); return 0
        if op == "run" and len(sys.argv) == 3:
            return exec_code(open(sys.argv[2]).read())
        if op == "exec" and len(sys.argv) == 3:
            return exec_code(sys.argv[2])
    except OSError as e:
        sys.stderr.write(f"fusion-bridge: Fusion is not reachable on {URL} ({e}). Open Fusion; the AnorBridge add-in runs on startup.\n"); return 1
    print(__doc__); return 2

if __name__ == "__main__":
    sys.exit(main())
